# Canonical site URL: used for canonical links, Open Graph, sitemap and JSON-LD.
# Production: https://oakteckgh.com   Local: http://localhost:3200
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Resend (https://resend.com) API key for the contact form.
# With a test key and no verified domain, Resend only delivers to the account owner's address.
RESEND_API_KEY=

# Where contact-form enquiries are delivered.
CONTACT_TO_EMAIL=amankrahjay@gmail.com

# Sender for contact-form emails. Until oakteckgh.com is verified in Resend use onboarding@resend.dev.
CONTACT_FROM_EMAIL="Oakteck website <onboarding@resend.dev>"
